{
  "name": "Scriptorium",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer"],
      "settings": {
        "rust-analyzer.check.command": "clippy"
      }
    }
  },
  "postCreateCommand": "rustup component add rustfmt clippy && cargo fetch",
  "remoteUser": "vscode"
}
